# Supabase is required for production persistence and email OTP authentication.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=kumod353@gmail.com

# Razorpay test-mode credentials. Keep the secret server-only.
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-test-key-secret
# This key is safe to expose to the browser; never expose RAZORPAY_KEY_SECRET.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Create the Growth monthly plan in Razorpay Test Mode and paste its plan_... ID here.
RAZORPAY_GROWTH_PLAN_ID=plan_your-growth-plan-id
# Number of monthly billing cycles for a subscription (120 is approximately 10 years).
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
# Supabase service-role key is used only by the signed Razorpay webhook route.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Google Maps business discovery through Outscraper.
# India searches automatically use region=IN, language=en, and append "India" to locations.
OUTSCRAPER_API_KEY=
OUTSCRAPER_LIMIT=50
# Maximum time in milliseconds for a Google Maps discovery request.
OUTSCRAPER_TIMEOUT_MS=35000
# Enriches every campaign for emails/social links; campaigns that explicitly
# require WhatsApp or social profiles request this enrichment automatically.
OUTSCRAPER_ENRICH_CONTACTS=false

# Direct OpenAI Responses API integration. Keep this server-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Server-only runtime mode flag. Set false for Supabase-backed local/production use.
BLIO_DEMO_MODE=true

# Legacy compatibility flag. BLIO_DEMO_MODE takes precedence when both exist.
NEXT_PUBLIC_DEMO_MODE=true

# Optional sample campaign/leads for screenshots. Keep false for a clean demo workspace.
BLIO_DEMO_SEED_DATA=false
NEXT_PUBLIC_DEMO_SEED_DATA=false
